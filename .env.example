# Configuración de base de datos y pgAdmin (ejemplo de referencia)
PORT=8080
JWT_SECRET=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgressecurepassword
POSTGRES_DB=core_service_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
PGADMIN_DEFAULT_EMAIL=admin@core-service.com
PGADMIN_DEFAULT_PASSWORD=adminsecurepassword
PGADMIN_PORT=5050
