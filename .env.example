# ==========================================================
# Core-Service - Variables de entorno (plantilla pública)
# Copiá este archivo a .env y reemplazá los valores por los tuyos.
# NUNCA commitees el .env con credenciales reales.
# ==========================================================

# ---------- API ----------
# Puerto interno del servicio Go (docker-compose lo mapea a API_PORT).
PORT=8080
# Puerto del host que expone la API en docker-compose.
API_PORT=8080
# Secreto usado para firmar/validar los JWT (HS256). Usá un valor largo y aleatorio.
JWT_SECRET=
# Orígenes permitidos por CORS, separados por coma (nunca "*" si AllowCredentials está activo).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Frontend ----------
# URL base de la API consumida desde el navegador (host del usuario)
VITE_API_URL=http://localhost:8080/api/v1

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=core_service_db
# Puerto del host mapeado al 5432 del contenedor.
POSTGRES_PORT=5432

# ---------- Almacenamiento S3 (LocalStack) ----------
# Endpoint público accesible desde el navegador para Presigned URLs y visualización de fotos
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=evidencias
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# ---------- Mensajería (RabbitMQ) ----------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=tickets.events

# ---------- Ejecución local (sin Docker) ----------
# Host donde corre PostgreSQL cuando ejecutás `go run cmd/api/main.go` en tu máquina.
POSTGRES_HOST=localhost
# Cadena de conexión usada por la app fuera de Docker (dentro de docker-compose se sobreescribe).
DATABASE_URL=postgres://postgres:cambia_esta_password@localhost:5432/core_service_db?sslmode=disable
